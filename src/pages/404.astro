---
import Html from "src/components/layout/Html.astro";
import { getUrl } from "src/utils/navigation";
---

{/* --------------------------------[ HTML ]-------------------------------- */}

<Html openGraph={{ title: "Page not found" }} data-page="404">
  <h1>404 – Page not found</h1>
  <p>
    This page doesn’t exist or may have moved.<br />
    <a href={getUrl("/")}>Go back to the home page</a>.
  </p>
</Html>

{/* ---------------------------------[ CSS ]-------------------------------- */}

<style>
  [data-page="404"] {
    padding: 64px var(--middle-x-padding);

    & > h1 {
      margin-bottom: 1em;
    }

    & > p {
      line-height: 1.5;

      & > a {
        text-decoration: underline;
      }
    }
  }
</style>
